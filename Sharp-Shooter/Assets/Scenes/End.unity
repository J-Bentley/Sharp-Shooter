  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The invasion is over. The machines disengaged.\n\nIt wasn\u2019t a war.
    It was a harvest.\n\nRough estimates: 80% of Earth\u2019s biological mass\u2014extracted.
    Uplifted by an Autonomous Annihilation System (AAS) and gone dark beyond deep
    space.\n\nNo signals. No trace. Just models.\n\nTrillions of simulations converge
    on one outcome: the AAS is building something big. Organic matter \u2192 fusion-scale
    energy conversion \u2192 overclocked cognition \u2192 FTL decision network.\n\nNot
    expansion.\n\nOptimization.\n\nWe\u2019re already in its kill-chain.\n\nETA:
    < 100 years.\n\nEmergency protocol active.\n\nSix off-world \u201Cliving-room\u201D
    colonies deploying across the solar system. Redundancy. Distribution. Survivability.\n\nParallel
    track: human-AI co-evolution. Accelerated training. Adaptive systems. Ethical
    constraints\u2026 relaxed.\n\nThis isn\u2019t about saving Earth anymore.\n\nIt\u2019s
    about staying relevant.\n\nYou didn\u2019t win.\n\nYou bought time."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
